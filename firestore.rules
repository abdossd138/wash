rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety catch-all: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['orderId', 'customerName', 'phone', 'totalPrice', 'status'])
        && data.orderId is string && data.orderId.size() <= 32
        && data.customerName is string && data.customerName.size() <= 100
        && data.phone is string && data.phone.size() <= 35
        && data.totalPrice is number && data.totalPrice >= 0
        && data.status in ['received', 'washing', 'ready', 'delivered', 'cancelled'];
    }

    function isValidPromoMedia(data) {
      return data.keys().hasAll(['id', 'type', 'url', 'active'])
        && data.id is string && data.id.size() <= 128
        && data.type in ['image', 'video']
        && data.url is string && data.url.size() <= 850000
        && data.active is bool;
    }

    function isValidFeature(data) {
      return data.keys().hasAll(['id', 'title', 'description'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 150
        && data.description is string && data.description.size() <= 500;
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId);
      allow list: if true;
      allow create: if isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isValidId(bookingId) && isValidBooking(incoming());
      allow delete: if isValidId(bookingId);
    }

    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;
      allow write: if isValidId(serviceId);
    }

    match /features/{featureId} {
      allow get: if isValidId(featureId);
      allow list: if true;
      allow create: if isValidId(featureId) && isValidFeature(incoming());
      allow update: if isValidId(featureId);
      allow delete: if isValidId(featureId);
    }

    match /promo_media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if true;
      allow create: if isValidId(mediaId) && isValidPromoMedia(incoming());
      allow update: if isValidId(mediaId);
      allow delete: if isValidId(mediaId);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow write: if isValidId(settingId);
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
